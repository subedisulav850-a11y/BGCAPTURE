<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- VPN -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />

    <!-- Overlay (display over screen) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:ignore="ProtectedPermissions"/>

    <!-- Wake lock to keep capture alive -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Storage for saving captures -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Query installed packages to launch FF -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>

    <queries>
        <!-- Free Fire package names -->
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.garena.game.fflite" />
        <package android:name="com.garena.game.ff" />
    </queries>

    <application
        android:name=".BashantApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="BASHANT CAPTURE"
        android:theme="@style/Theme.BashantCapture"
        android:supportsRtl="false"
        android:hardwareAccelerated="true">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VPN Service — the core capture engine -->
        <service
            android:name=".service.BashantVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>

        <!-- Overlay log window service -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"/>

        <!-- Packet capture notification channel -->
        <receiver
            android:name=".service.CaptureReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bashant.capture.ACTION_STOP" />
                <action android:name="com.bashant.capture.ACTION_LAUNCH_FF" />
                <action android:name="com.bashant.capture.ACTION_EXPORT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
